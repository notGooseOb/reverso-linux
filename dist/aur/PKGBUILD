# Contributor: Your Name <email@example.com>

pkgname=reverso-linux
pkgver=0.0.3
pkgrel=1
pkgdesc="A Linux desktop translator using the Reverso API"
arch=('x86_64')
url="https://github.com/YOUR_USERNAME/reverso-linux"
license=('MIT')
depends=('pango' 'cairo' 'fontconfig' 'curl')
makedepends=('pkg-config' 'rust')
source=("$pkgname-v$pkgver.tar.gz::https://github.com/YOUR_USERNAME/reverso-linux/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-v$pkgver"
  APP_VERSION="$pkgver" cargo build --release --locked
}

package() {
  cd "$srcdir/$pkgname-v$pkgver"
  install -Dm755 target/release/reverso-linux "$pkgdir/usr/bin/reverso-linux"
}
